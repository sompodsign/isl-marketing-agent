# Required in production; enables HTTP Basic authentication for the dashboard.
DASHBOARD_PASSWORD=change-me
PORT=8000
APP_ENV=development
ENABLE_INTERNAL_SCHEDULER=true
# Choose auto, openai, gemini, or deepseek. Auto uses OpenAI, then Gemini, then DeepSeek.
WRITER_PROVIDER=auto
# Optional persistent location for the SQLite database and uploaded media.
# MARKETING_AGENT_DATA_DIR=/var/lib/isl-marketing-agent

# Used to write grounded Facebook copy through DeepSeek's OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Gemini is preferred when configured. Screenshots are not sent to the model;
# only their reviewed labels and descriptions are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI is the preferred writing provider when configured. Screenshots are not
# sent to the model; only their reviewed labels and descriptions are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Facebook Page publishing. Use a Page access token with the required Meta permissions.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Set a Graph API version you have enabled in your Meta app, e.g. vXX.X.
FACEBOOK_GRAPH_VERSION=vXX.X

# LinkedIn Company Page publishing. Requires a LinkedIn app with the
# "Community Management API" product approved, and the token owner must be an
# admin (Super admin or Content admin) of the Company Page. Run
# `python scripts/linkedin_token.py authorize` to start the 3-legged OAuth flow.
# Access tokens expire after ~60 days; refresh with
# `python scripts/linkedin_token.py refresh`.
LINKEDIN_ACCESS_TOKEN=
# The posting target: urn:li:organization:<PAGE_ID> for the business page
# (a bare numeric page id also works) or urn:li:person:<ID> for a profile.
LINKEDIN_AUTHOR_URN=
# REST header version, YYYYMM. Override only if LinkedIn asks for a specific version.
LINKEDIN_API_VERSION=202506
# Optional: only needed by scripts/linkedin_token.py.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/linkedin/callback
LINKEDIN_REFRESH_TOKEN=
