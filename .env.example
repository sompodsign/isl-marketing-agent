# Required in production; enables HTTP Basic authentication for the dashboard.
DASHBOARD_PASSWORD=change-me
PORT=8000

# Used to write grounded Facebook copy through DeepSeek's OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Facebook Page publishing. Use a Page access token with the required Meta permissions.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Set a Graph API version you have enabled in your Meta app, e.g. vXX.X.
FACEBOOK_GRAPH_VERSION=vXX.X
